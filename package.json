{
  "name": "mygym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gimnasio isométrico con guion articular de técnica por estación",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts",
    "docs": "tsx scripts/gen-docs.ts",
    "anatomy:bodymap": "tsx scripts/anatomy/bodymap-svg.ts",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/player": "4.0.536",
    "@remotion/three": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@remotion/cli": "4.0.536",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
